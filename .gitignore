# Python
.venv/
__pycache__/
*.pyc

# Large raw source data — not redistributed; refetch with the scripts.
# See DATA_SOURCES.md for every endpoint, licence and manual-download URL.
# data/bgs_625k_bedrock.geojson  (~32 MB) -> scripts/fetch_bgs.py
data/bgs_625k_bedrock.geojson
# data/bgs_625k_superficial.geojson (~24 MB) -> scripts/fetch_bgs.py --superficial
data/bgs_625k_superficial.geojson
# data/ea_postcode_risk.csv      (~34 MB) -> manual download, DATA_SOURCES.md #13
data/ea_postcode_risk.csv
# boundary polygons -> git clone, see README
data/uk-postcode-polygons/
data/haduk/

# Download cache — refetchable via scripts/fetch_households.py.
# The derived data/households.csv IS committed, so nothing here is needed
# to rebuild the model.
data/cache/

# Intermediate artefacts
data/sw_wales20.csv
# Derived sector polygons (~tens of MB; rebuild: fetch_codepoint.py then
# derive_sectors.py, ~15 min). Not a model input yet - see DATA_SOURCES.
data/sectors_gb.gpkg

# Build outputs — the published copies live in docs/ (built by build_site.py)
map/uk_home_insurance_risk_map.html
map/map_data.geojson
analysis/uk_risk_year_analysis.html
# fetch_bgs.py resume checkpoints (deleted on a complete fetch)
data/*.progress.jsonl
data/*.progress.json
data/*.partial
