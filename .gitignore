# Python
.venv/
__pycache__/
*.pyc

# Sibling worktrees of THIS repo, kept inside the project folder so both
# resolutions live in one place (moved here 2026-08-23).
# .worktrees/sector-model is the `sector-model` branch - the same model at
# postcode-SECTOR resolution. It must be ignored: a worktree nested inside
# another worktree of the same repo otherwise shows up as ~20 MB of
# untracked content and can be committed to main by accident.
# Remember the one-way rule - main merges INTO sector-model, never back.
.worktrees/

# Large raw source data — not redistributed; refetch with the scripts.
# See DATA_SOURCES.md for every endpoint, licence and manual-download URL.
# data/bgs_625k_bedrock.geojson  (~32 MB) -> scripts/fetch_bgs.py
data/bgs_625k_bedrock.geojson
# data/bgs_625k_superficial.geojson (~24 MB) -> scripts/fetch_bgs.py --superficial
data/bgs_625k_superficial.geojson
# data/ea_postcode_risk.csv      (~34 MB) -> manual download, DATA_SOURCES.md #13
data/ea_postcode_risk.csv
# boundary polygons -> git clone, see README
data/uk-postcode-polygons/
data/haduk/

# Download cache — refetchable via scripts/fetch_households.py.
# The derived data/households.csv IS committed, so nothing here is needed
# to rebuild the model.
data/cache/

# Intermediate artefacts
data/sw_wales20.csv
# Derived sector polygons (~25 MB; rebuild: fetch_codepoint.py then
# derive_sectors.py, ~5 min). The MODEL OUTPUT built on them
# (data/sectors_risk.geojson) IS committed - it is a published product.
data/sectors_gb.gpkg
# MIDAS Open mirror (needs a CEDA token; refetch: fetch_midas.py).
# The derived data/gusts_midas.csv IS committed once produced.
data/midas/

# Build outputs — the published copies live in docs/ (built by build_site.py)
map/uk_home_insurance_risk_map.html
map/uk_sector_risk_map.html
map/map_data.geojson
map/sector_data.geojson
map/tiles/
map/units/
map/districts_index.json
map/sectors_index.json
analysis/uk_risk_year_analysis.html
# fetch_bgs.py resume checkpoints (deleted on a complete fetch)
data/*.progress.jsonl
data/*.progress.json
data/*.partial

# derived climate tables and their resume state (rebuild with
# scripts/haduk_1km_stream.py / haduk_district_daily.py)
data/haduk_district_annual*.csv
data/haduk_1km_state.npz
data/haduk_1km_weights.npz

# ONSPD mirror and the derived UK-wide postcode centroids (89 MB;
# rebuild with scripts/fetch_onspd.py). The centroids are an input to
# the polygon rebuild, not a model output.
data/cache/onspd_full.zip
data/postcode_centroids.csv

# Full-resolution rebuilt geometry and the coastline it is clipped to.
# All regenerable: scripts/fetch_onspd.py then
# scripts/build_postcode_polygons.py. These are ANALYSIS geometry - the
# published layers are simplified copies, see build_postcode_polygons.py.
data/cache/uk_coastline_bfc.geojson
data/cache/uk_land.wkb
data/districts_uk.gpkg
data/districts_uk.geojson
data/sectors_uk.gpkg
data/sectors_uk_display.geojson
data/districts_uk_display.geojson
data/districts_uk.pmtiles

# Built by build_tiles.py and copied into docs/ by build_site.py. NOT
# committed: PMTiles are already compressed, so git cannot delta them,
# and committing both grains would put ~33 MB into the packfile on
# every publish against ~3.5 MB for the GeoJSON they replace. Pages is
# served from the build artifact instead (.github/workflows/pages.yml).
docs/assets/tiles/
docs/assets/units/
docs/assets/districts_index.json
docs/assets/sectors_index.json
